{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        { // did not launched correctly ? typically that's because you have 2 STM32 boards connected
            "name": "Debug NUCLEO-U5A5ZJ-Q (lean-bsp)",
            "cwd": "${workspaceFolder}",
            "type": "cortex-debug",
            "executable": "${workspaceFolder}/build/nucleo-u5a5/cortex-m33/lean-ftl-test.elf",
            "preLaunchTask": "lbsp build nucleo-u5a5",
            "request": "launch",
            "servertype": "stlink",
            "device": "STM32U5A5ZJTxQ",
            "interface": "swd",
            //Set ST-Link ID if you use multiple at the same time
            "serialNumber": "${env:LFTL_STLINK_NUCLEO_U5A5}",   // ST-LINK serial; unset = first probe found
            "runToEntryPoint": "app_main",
            "svdFile": "${config:STM32VSCodeExtension.cubeCLT.path}/STMicroelectronics_CMSIS_SVD/STM32U5A5.svd",
            "v1": false,
            "serverpath": "${config:STM32VSCodeExtension.cubeCLT.path}/STLink-gdb-server/bin/ST-LINK_gdbserver",
            "stm32cubeprogrammer": "${config:STM32VSCodeExtension.cubeCLT.path}/STM32CubeProgrammer/bin",
            "stlinkPath": "${config:STM32VSCodeExtension.cubeCLT.path}/STLink-gdb-server/bin/ST-LINK_gdbserver",
            "armToolchainPath": "${config:STM32VSCodeExtension.cubeCLT.path}/GNU-tools-for-STM32/bin",
            "gdbPath": "${config:STM32VSCodeExtension.cubeCLT.path}/GNU-tools-for-STM32/bin/arm-none-eabi-gdb",
            "serverArgs": ["-m", "0"]
        },
        { // did not launched correctly ? typically that's because you have 2 STM32 boards connected
            "name": "Debug NUCLEO-L552ZE-Q (lean-bsp)",
            "cwd": "${workspaceFolder}",
            "type": "cortex-debug",
            "executable": "${workspaceFolder}/build/nucleo-l552/cortex-m33/lean-ftl-test.elf",
            "preLaunchTask": "lbsp build nucleo-l552",
            "request": "launch",
            "servertype": "stlink",
            "device": "STM32L552ZETxQ",
            "interface": "swd",
            //Set ST-Link ID if you use multiple at the same time
            "serialNumber": "${env:LFTL_STLINK_NUCLEO_L552}",   // ST-LINK serial; unset = first probe found
            "runToEntryPoint": "app_main",
            "svdFile": "${config:STM32VSCodeExtension.cubeCLT.path}/STMicroelectronics_CMSIS_SVD/STM32L552.svd",
            "v1": false,
            "serverpath": "${config:STM32VSCodeExtension.cubeCLT.path}/STLink-gdb-server/bin/ST-LINK_gdbserver",
            "stm32cubeprogrammer": "${config:STM32VSCodeExtension.cubeCLT.path}/STM32CubeProgrammer/bin",
            "stlinkPath": "${config:STM32VSCodeExtension.cubeCLT.path}/STLink-gdb-server/bin/ST-LINK_gdbserver",
            "armToolchainPath": "${config:STM32VSCodeExtension.cubeCLT.path}/GNU-tools-for-STM32/bin",
            "gdbPath": "${config:STM32VSCodeExtension.cubeCLT.path}/GNU-tools-for-STM32/bin/arm-none-eabi-gdb",
            "serverArgs": ["-m", "0"]
        },
        {
            "name": "Debug Linux",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/linux/lean-ftl-test-fw",
            "args": ["--test=${input:lftlTest}", "--tear-at=${input:lftlTearAt}"],
            "stopAtEntry": true,
            "cwd": "${workspaceFolder}/build/linux",
            "preLaunchTask": "build linux debug",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "Debug single area",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/linux/single_area",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ]
        },
    ],
    "inputs": [
        { "id": "lftlTest", "type": "promptString", "description": "test number (--test=), 0 for all of them", "default": "1" },
        { "id": "lftlTearAt", "type": "promptString", "description": "cut to run alone (--tear-at=), 0 for all of them", "default": "0" }
    ]
}