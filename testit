#!/bin/bash

set -ex

OUTDIR="build/"$(basename ${1})

./buildit $*

cd $OUTDIR

#examples are always built for linux regardless of the selected target

INCLUDES="-I../../liblean-ftl/include -I../../liblean-ftl-test/include" 
LIBS="-Lliblean-ftl -llean-ftl"
#page and write unit sizes must match on/linux: the NVM simulator linked in liblean-ftl uses those
DEFINES="-DLFTL_PAGE_SIZE=(4*1024) -DLFTL_WU_SIZE=2 -DLINUX=1"

gcc -Og ../../examples/hello/main.c -o hello $INCLUDES $LIBS 

gcc -O0 -g3 -ggdb -E ../../examples/single_area/main.c $DEFINES -I../../examples/single_area $INCLUDES > single_area_main.c.i
gcc -O0 -g3 -ggdb ../../examples/single_area/main.c ../../target/linux/linux.c -o single_area $DEFINES $INCLUDES $LIBS

#every test, in parallel (LFTL_TEST_JOBS processes at a time, default: one per processor), on the
#default flash model and on a flash without the all-zero exception (N3 of the flash page), where
#the scan never programs. ./lean-ftl-test-fw alone runs them in sequence in one process
../../test/run-suite . --modes "default no-pinning"

./hello

./single_area

#ASan harness of the threat model, also always built for linux
../../test/asan/build-and-run