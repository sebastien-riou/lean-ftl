#!/bin/bash

# Runs the tests of the test firmware in parallel: one process per test and
# per flash model, and several per test whose sweep of power cuts is long,
# each process taking its share of the cuts (--shard=K --shards=N). The cuts
# run are those of a sequential run, whatever the number of jobs.
#
# Usage: test/run-suite <build dir> [-j N] [--tests "N..."] [--modes "MODE..."] [--logs DIR]
#   <build dir>  where lean-ftl-test-fw is, e.g. build/linux
#   -j N         jobs at a time; default: LFTL_TEST_JOBS, else the number of
#                processors. -j 1 runs the jobs one after the other
#   --tests      test numbers; default: all of them
#   --modes      flash models, among: default (zero overwrite and weak words),
#                no-pinning, no-weak-words; default: "default"
#   --logs       where the logs go, replacing those of an earlier run; default:
#                <build dir>/test-logs
#
# One log per job. Prints the slowest jobs, and
# for each job that failed the end of its log and the command that runs it
# again alone. Exits with 1 when a job failed. There is no timeout.

set -u

usage(){ sed -n '3,21p' "$0"; exit 2; }
[ $# -ge 1 ] || usage
OUTDIR=$(cd "$1" && pwd) || usage
shift
JOBS=${LFTL_TEST_JOBS:-$(nproc)}
TESTS=""
MODES="default"
LOGDIR=""
while [ $# -gt 0 ]; do
  case "$1" in
    -j) JOBS=$2; shift 2;;
    --tests) TESTS=$2; shift 2;;
    --modes) MODES=$2; shift 2;;
    --logs) LOGDIR=$2; shift 2;;
    *) usage;;
  esac
done
FW="$OUTDIR/lean-ftl-test-fw"
[ -x "$FW" ] || { echo "ERROR: $FW not found"; exit 2; }
if [ -z "$TESTS" ]; then
  N=$("$FW" --n-tests | tr -d '\r' | grep -E '^[0-9]+$' | tail -1)
  TESTS=$(seq 1 "$N")
fi

# The processes a test is split into, from the number of cuts of its sweeps
# (the "targets for tearing simulation" lines of its log): tune it when a
# test grows, the table of the slowest jobs below shows when
shards_of(){
  case "$1" in
    7|8) echo 16;;
    33|41) echo 8;;
    42) echo 4;;
    *) echo 1;;
  esac
}

mode_arg(){
  case "$1" in
    default) echo "";;
    no-pinning) echo "--no-pinning";;
    no-weak-words) echo "--no-weak-words";;
    *) echo "ERROR: unknown mode '$1'" >&2; exit 2;;
  esac
}
for m in $MODES; do mode_arg "$m" > /dev/null || exit 2; done

[ -n "$LOGDIR" ] || LOGDIR="$OUTDIR/test-logs"
mkdir -p "$LOGDIR"
LOGDIR=$(cd "$LOGDIR" && pwd)
rm -f "$LOGDIR"/*.log "$LOGDIR"/*.res "$LOGDIR"/summary.txt

# one job: its log, then "<seconds> <exit code> <job name> <command>" in a result file
run_job(){
  local mode=$1 test=$2 shard=$3 shards=$4
  local args="--test=$test $(mode_arg "$mode")"
  local name="$mode-$test"
  if [ "$shards" -gt 1 ]; then
    args="$args --shard=$shard --shards=$shards"
    name="$name-shard$shard"
  fi
  local start=$(date +%s%N)
  local rc=0
  # shellcheck disable=SC2086
  (cd "$OUTDIR" && ./lean-ftl-test-fw $args) > "$LOGDIR/$name.log" 2>&1 || rc=$?
  local end=$(date +%s%N)
  echo "$(( (end - start) / 100000000 )) $rc $name ./lean-ftl-test-fw $args" | sed -E 's/^([0-9]*)([0-9]) /\1.\2 /; s/^\./0./' > "$LOGDIR/$name.res"
}
export -f run_job mode_arg
export OUTDIR LOGDIR

# the split tests first: they are the long ones
joblist(){
  local pass
  for pass in split whole; do
    for m in $MODES; do
      for t in $TESTS; do
        local n=$(shards_of "$t")
        if [ "$pass" = split ] && [ "$n" -gt 1 ]; then
          for k in $(seq 0 $((n-1))); do echo "$m $t $k $n"; done
        fi
        if [ "$pass" = whole ] && [ "$n" -eq 1 ]; then echo "$m $t 0 1"; fi
      done
    done
  done
}

N_JOBS=$(joblist | wc -l)
echo "run-suite: $N_JOBS jobs, $JOBS at a time, logs in $LOGDIR"
START=$(date +%s)
joblist | xargs -P "$JOBS" -L 1 bash -c 'run_job "$@" 2>/dev/null' _
END=$(date +%s)

cat "$LOGDIR"/*.res | sort -g -r > "$LOGDIR/summary.txt"
echo "run-suite: $((END-START)) s of wall time, $(awk '{s+=$1} END{printf "%.0f", s}' "$LOGDIR/summary.txt") s summed over the jobs; the slowest:"
head -8 "$LOGDIR/summary.txt" | awk '{printf "  %7.1f s  %s\n", $1, $3}'

FAILED=0
if [ "$(wc -l < "$LOGDIR/summary.txt")" -ne "$N_JOBS" ]; then
  echo "ERROR: $N_JOBS jobs were started, $(wc -l < "$LOGDIR/summary.txt") reported"
  FAILED=1
fi
while read -r seconds rc name cmd; do
  [ "$rc" -eq 0 ] && continue
  FAILED=1
  log="$LOGDIR/$name.log"
  echo "FAILED (exit code $rc): $name, log $log"
  # the progress bar ends in a carriage return: what follows it on its line is kept
  tr '\r' '\n' < "$log" | sed -E 's/^ *[0-9]+% \[[| ]*\]//' | grep -a -v '^$' | tail -8 | sed 's/^/    /'
  # the cut the log names, when it names one: alone it reproduces the failure
  cut=$(tr '\r' '\n' < "$log" | grep -a -o '^  cut [0-9]*' | tail -1 | awk '{print $2}')
  repro=$(echo "$cmd" | sed -E 's/ --shard=[0-9]+ --shards=[0-9]+//')
  echo "  run it again alone: (cd $OUTDIR && $repro${cut:+ --tear-at=$cut})"
done < "$LOGDIR/summary.txt"

if [ $FAILED -ne 0 ]; then
  echo "run-suite: FAILED"
  exit 1
fi
echo "run-suite: all $N_JOBS jobs PASSED"
