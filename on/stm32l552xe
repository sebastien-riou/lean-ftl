set(LFTL_DEVICE_BSP nucleo-l552)
set(LFTL_DEVICE_BSP_INCLUDES
  include
  Core/Inc
  Drivers/STM32L5xx_HAL_Driver/Inc
  Drivers/STM32L5xx_HAL_Driver/Inc/Legacy
  Drivers/CMSIS/Device/ST/STM32L5xx/Include
  Drivers/CMSIS/Include
)
set(LFTL_DEVICE_BSP_DEFINES USE_HAL_DRIVER USE_FULL_LL_DRIVER STM32L552xx)
set(LFTL_DEVICE_NVM_BASE 0x08000000u)
set(LFTL_DEVICE_NVM_SIZE 0x80000u)
include("${CMAKE_CURRENT_LIST_DIR}/../cmake/device-lib.cmake")
