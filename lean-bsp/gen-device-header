#!/usr/bin/env python3
"""Writes the header of a device library (cmake/device-lib.cmake): the geometry of the flash, read
from the bsp.toml of the BSP the accessors come from, the range the library was built for, and the
prototypes of the three accessors. A user includes it before lean-ftl.h.

Usage: gen-device-header --bsp <BSP directory> --device <name> --base <addr> --size <bytes> --out <file>
"""

import argparse
import subprocess
import sys
import tomllib
from pathlib import Path


def bsp_commit(root: Path) -> str:
    """The BSP's commit, with -dirty when its tree has changes; 'unknown' outside git."""
    try:
        out = subprocess.run(['git', '-C', str(root), 'describe', '--always', '--dirty', '--abbrev=12'],
                             capture_output=True, text=True, check=True, timeout=30)
        return out.stdout.strip()
    except (OSError, subprocess.SubprocessError):
        return 'unknown'


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument('--bsp', required=True, type=Path)
    parser.add_argument('--device', required=True)
    parser.add_argument('--base', required=True)
    parser.add_argument('--size', required=True)
    parser.add_argument('--out', required=True, type=Path)
    args = parser.parse_args()

    with open(args.bsp / 'bsp.toml', 'rb') as f:
        bsp = tomllib.load(f)['bsp']
    regions = bsp.get('nvm_regions', [])
    if not regions:
        print(f'ERROR: {args.bsp}/bsp.toml declares no NVM region', file=sys.stderr)
        return 1
    region = regions[0]
    page_size, write_size = region['page_size'], region['write_size']
    base, size = int(args.base.rstrip('uU'), 0), int(args.size.rstrip('uU'), 0)
    if base % page_size or size % page_size:
        print(f'ERROR: the range {base:#x} + {size:#x} is not whole erase units of {page_size} bytes', file=sys.stderr)
        return 1

    args.out.write_text(f"""\
/* lean-ftl device library "{args.device}": include this header before lean-ftl.h.
 *
 * Generated by lean-ftl (lean-bsp/gen-device-header). The accessors in the library are those of
 * the lean-bsp BSP "{bsp['name']}" ({bsp.get('description', '')}),
 * src/bsp_nvm.c at {bsp_commit(args.bsp)}, built for the range below. */
#pragma once

#include <stdint.h>

#define LFTL_DEFINE_HELPERS
#define LFTL_PAGE_SIZE {page_size} /* the erase unit, in bytes */
#define LFTL_WU_SIZE {write_size} /* the write unit, in bytes */
/* for lftl_nvm_props_t.zero_overwrite: whether all zeros may be programmed over a programmed unit */
#define LFTL_ZERO_OVERWRITE {1 if region.get('zero_overwrite', False) else 0}

/* The range the accessors accept; they refuse any address outside it. */
#define LFTL_DEVICE_NVM_BASE {base:#010x}u
#define LFTL_DEVICE_NVM_SIZE {size:#x}u

/* The accessors, for lftl_nvm_props_t. */
uint8_t nvm_erase(void *base_address, unsigned int n_pages);
uint8_t nvm_write(void *dst_nvm_addr, const void *const src, uintptr_t size);
uint8_t nvm_read(void *dst, const void *const src_nvm_addr, uintptr_t size);
""")
    return 0


if __name__ == '__main__':
    sys.exit(main())
